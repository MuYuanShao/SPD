{
  "name": "spd-mobile",
  "private": true,
  "version": "1.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1830",
    "build": "vue-tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/server-config.test.ts tests/signing-flow.test.ts tests/picking-flow.test.ts tests/consumption-flow.test.ts",
    "cap:sync": "npm run build && npx cap sync android",
    "android": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@lucide/vue": "^1.25.0",
    "axios": "^1.18.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
