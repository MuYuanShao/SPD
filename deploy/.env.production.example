# Copy these values into the deployment host environment or a private .env file.
# Do not commit real production secrets.

SPD_HTTP_PORT=1820
SPD_DB_NAME=ISPD
SPD_DB_USERNAME=admin
SPD_DB_PASSWORD=replace-with-a-strong-database-password
SPD_DB_ROOT_PASSWORD=replace-with-a-strong-root-password
SPD_JWT_SECRET=replace-with-at-least-48-random-characters-for-jwt-signing
SPD_JWT_EXPIRATION=86400000

REQUIRE_DEPLOYMENT_TOOLS=1
REQUIRE_PRODUCTION_CONFIG=1
RUN_DOCKER_COMPOSE_UP=1
RUN_DEPLOYMENT_PRESSURE=1
DEPLOYMENT_BASE_URL=http://localhost:1820/api
DEPLOYMENT_HEALTH_URL=http://localhost:1820/api/health
K6_SUMMARY_FILE=perf/results/k6-deployment-summary.json
