# Optional manual configuration. Recommended: start.ps1/start.sh generates deploy/.env once.
# Never commit deploy/.env or regenerate it when reusing existing database volumes.
COMPOSE_PROJECT_NAME=hospital-spd
SPD_IMAGE_TAG=20261020
SPD_HTTP_PORT=1820
SPD_DB_NAME=ISPD
SPD_DB_USERNAME=spd_runtime
SPD_DB_PASSWORD=replace-with-at-least-16-random-characters
SPD_DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password
SPD_FLYWAY_USERNAME=spd_migrate
SPD_FLYWAY_PASSWORD=replace-with-a-different-strong-migration-password
SPD_JWT_SECRET=replace-with-at-least-48-random-characters-and-not-this-placeholder
SPD_INITIAL_ADMIN_PASSWORD=replace-with-at-least-16-random-characters
SPD_JWT_EXPIRATION=86400000

# Mobile API requires a stable server identity and review signing secret.
SPD_MOBILE_ENABLED=false
SPD_MOBILE_SERVER_ID=
SPD_MOBILE_REVIEW_SECRET=
SPD_CORS_ALLOWED_ORIGINS=http://localhost:1820,http://127.0.0.1:1820

# Core deployment does not require AI. Use -WithAi / --with-ai to include Ollama and its model.
SPD_AI_BASE_URL=http://ollama:11434
SPD_AI_MODEL=qwen3-vl:8b
SPD_AI_TIMEOUT_MS=120000
SPD_OLLAMA_IMAGE=ollama/ollama:latest

# External hospital/MCP systems must be configured with their real addresses and service credentials.
SPD_MCP_ENABLED=false
SPD_MCP_UPLOAD_ENABLED=false
SPD_MCP_PHASE2_UPLOAD_ENABLED=false
SPD_MCP_ORGANIZATION=
SPD_MCP_SHARED_TOKEN=
SPD_MCP_OPERATOR_ID=0
SPD_MCP_UI_URL=
SPD_MCP_UI_INSTANCE_ID=
SPD_MCP_UI_TENANT_ID=1
SPD_MCP_UI_USERNAME=
SPD_MCP_UI_PASSWORD=
SPD_MCP_UI_API_KEY=
SPD_MCP_CURRENCY=
SPD_MCP_TAX_INCLUDED=
SPD_MCP_SOURCE_ZONE=Asia/Shanghai

# Existing database volume identity; preserve when upgrading old deployments.
# SPD_MYSQL_VOLUME=deploy_spd-mysql-data
SPD_ALLOW_NEW_DATABASE=false
